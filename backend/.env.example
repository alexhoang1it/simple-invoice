# API configuration. Copy to .env and adjust.
# Every value below is a placeholder; no real credential is committed.

NODE_ENV=development
PORT=4000

# Postgres connection string. Use localhost:5433 when the API runs on the host
# and the database comes from docker compose; use db:5432 inside the compose
# network.
DATABASE_URL=postgresql://simpleinvoice:local-dev-password@localhost:5433/simpleinvoice?schema=public

# At least 32 characters. There is no default on purpose — an API that boots
# with a fallback signing key is an API whose tokens can be forged.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-thirty-two-random-characters

# Access token lifetime in seconds. Defaults to 3600 when unset.
JWT_TTL_SECONDS=3600

# Browser origins allowed to call the API, comma separated.
# 5174 is the Vite dev server, 8081 is the containerised web app.
CORS_ORIGINS=http://localhost:5174,http://localhost:8081

# Page size used when the client does not ask, and the ceiling it will honour.
PAGE_SIZE_DEFAULT=10
PAGE_SIZE_MAX=100

# Log every SQL statement. Handy when working on the list query.
LOG_SQL=false

# Reviewer account created by `npm run seed`.
SEED_EMAIL=reviewer@simpleinvoice.dev
SEED_PASSWORD=invoice2026
SEED_NAME=Ops Reviewer

# Generated invoices on top of the Appendix A record. The brief asks for 20-50.
SEED_INVOICES=32
