{
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": { "^.+\\.ts$": ["ts-jest", { "isolatedModules": true }] },
  "setupFiles": ["<rootDir>/env-e2e.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testTimeout": 60000
}
