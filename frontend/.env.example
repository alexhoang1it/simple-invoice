# Web client configuration. Both values are optional - the app runs without a
# .env file at all.
#
# Only VITE_* variables reach the browser, and everything here ends up in the
# bundle. Never put a secret in this file.

# Base path the app prefixes to every API call. Leave it as /api so requests are
# same-origin and get proxied (by Vite in dev, by nginx in the container). Set an
# absolute URL only when pointing the app at an API on another host.
VITE_API_BASE=/api

# Dev server only: where Vite forwards /api.
VITE_API_PROXY=http://localhost:4000
