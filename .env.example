# docker compose reads this file automatically.
#
#   cp .env.example .env
#
# The two variables with no default — POSTGRES_PASSWORD and JWT_SECRET — are
# required. Compose refuses to start without them rather than falling back to a
# value that would be identical in every install.
#
# backend/.env.example and frontend/.env.example cover running the stack without Docker.

POSTGRES_PASSWORD=local-dev-password

# Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-thirty-two-random-characters

# Host ports. Chosen off the usual defaults so this stack does not collide with
# anything else you have running.
WEB_PORT=8081
API_PORT=4000
DB_PORT=5433

POSTGRES_USER=simpleinvoice
POSTGRES_DB=simpleinvoice

JWT_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:8081
PAGE_SIZE_DEFAULT=10
PAGE_SIZE_MAX=100

# Reviewer account the seed creates. Change these and the hint on the sign-in
# screen no longer matches, so update the README too.
SEED_EMAIL=reviewer@simpleinvoice.dev
SEED_PASSWORD=invoice2026
SEED_NAME=Ops Reviewer
SEED_INVOICES=32
